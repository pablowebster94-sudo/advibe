DATABASE_URL="file:./dev.db"

# Background job dispatch (see ARCHITECTURE.md -> "Async job queue").
# CRON_SECRET protects /api/jobs/process and /api/cron/sweep — required, the
# app fails closed without it. Generate any random string (min 16 chars).
# The same value must be set in Vercel's project settings for Vercel Cron to
# authenticate automatically.
CRON_SECRET="dev-only-local-secret-change-me"
# This app's own public URL, used by the self-chaining worker dispatch.
# Deliberately NOT Vercel's VERCEL_URL (that's per-deployment and changes on
# every deploy/preview). Required in production; defaults to
# http://localhost:3000 outside production.
APP_URL="http://localhost:3000"
# How many parallel self-perpetuating worker chains to start per campaign.
# 1 = fully sequential (safe default). Tested at 3.
JOB_CONCURRENCY=1
# Only needed if Vercel Deployment Protection is enabled on this project —
# Vercel auto-injects this when you configure "Protection Bypass for
# Automation" in project settings. Lets our own self-chain kicks reach the
# worker route instead of being intercepted by the SSO/password gate.
# VERCEL_AUTOMATION_BYPASS_SECRET=""

# Storage: "local" writes to ./storage on disk (fine for a single
# long-lived instance, NOT for Vercel — its filesystem is ephemeral per
# invocation). Set "s3" + the vars below for production: any S3-API-compatible
# bucket works, including Cloudflare R2 (recommended for this app's
# read-heavy image serving: zero egress fees). The DB only ever stores the
# object key; every read signs a short-lived URL on demand (see
# ARCHITECTURE.md -> "Storage").
STORAGE_PROVIDER="local"
# S3_BUCKET=""
# AWS_REGION="auto"
# Leave unset for real AWS S3. For R2: https://<account_id>.r2.cloudflarestorage.com
# S3_ENDPOINT=""
# R2 (and most non-AWS S3-compatible stores) need path-style requests.
# S3_FORCE_PATH_STYLE="true"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# How long a signed read URL stays valid, in seconds. Default 3600 (1h).
# S3_SIGNED_URL_TTL_SECONDS=3600

# Image generation: "local-compositor" renders creatives with sharp/SVG and
# needs no API key, so the MVP works out of the box. Set "gemini" to
# generate the background/scene with Google's Gemini ("Nano Banana") image
# model instead — the product photo is still preserved exactly and all copy
# (headline/price/CTA) is still rendered deterministically, never by the AI.
IMAGE_PROVIDER="local-compositor"
# GEMINI_API_KEY=""
# GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# Copywriting: "template" is a deterministic, no-API-key engine that never
# invents facts. Swap to "anthropic" once a key is available.
COPY_PROVIDER="template"
# ANTHROPIC_API_KEY=""
