# Preview-only template. Populate values in the separate Vercel ventads-ai project.
# Do not reuse AdVibe production credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ventads_preview?sslmode=require"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ventads_test?sslmode=require"

BASIC_AUTH_USER="ventads-preview"
BASIC_AUTH_PASSWORD="REPLACE_WITH_A_LONG_RANDOM_SECRET"
CRON_SECRET="REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET"
APP_URL="https://YOUR-VENTADS-PREVIEW-DOMAIN"

# Vercel ephemeral filesystems are not durable.
STORAGE_PROVIDER="s3"
S3_BUCKET="YOUR_PRIVATE_BUCKET"
AWS_REGION="auto"
S3_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
S3_FORCE_PATH_STYLE="true"
AWS_ACCESS_KEY_ID="REPLACE_ME"
AWS_SECRET_ACCESS_KEY="REPLACE_ME"
S3_SIGNED_URL_TTL_SECONDS="3600"

# Set only when ready to make real, billable image-generation requests.
IMAGE_PROVIDER="local-compositor"
# GEMINI_API_KEY="REPLACE_ME"
# GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
COPY_PROVIDER="template"
