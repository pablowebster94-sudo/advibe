# ─────────────────────────────────────────────────────────────────────────────
# AdVibe site
# ─────────────────────────────────────────────────────────────────────────────
# No external AI provider is required for the current Vibe diagnostic assistant.
# Future generative-AI integrations can be added here without exposing secrets
# to the client.

# ─────────────────────────────────────────────────────────────────────────────
# Licor Store 24 storefront (/licor-store-24)
# ─────────────────────────────────────────────────────────────────────────────
# Public origin used for canonical URLs, Open Graph tags and structured data.
NEXT_PUBLIC_LICOR_SITE_URL=

# Meta Pixel — the browser-side pixel/dataset id ("META_PIXEL_ID").
# Leave empty to run the storefront with tracking switched off.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API — server-side token. NEVER prefix this with NEXT_PUBLIC_.
# Required (together with the pixel id) for server-side event forwarding.
META_CAPI_ACCESS_TOKEN=
# Optional: routes events to Events Manager "Test events" instead of production.
META_CAPI_TEST_EVENT_CODE=
# Optional: Graph API version, defaults to v21.0
META_GRAPH_API_VERSION=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA4_ID=

# Payment provider (not enabled yet — see lib/licor/payments.ts).
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
