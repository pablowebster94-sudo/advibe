# No external AI provider is required for the current Vibe diagnostic assistant.
# Future generative-AI integrations can be added here without exposing secrets to the client.

# ── AdVibe (advibeagencia.com) ─────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
NEXT_PUBLIC_GA_ID=
# Optional booking URL for the AdVibe diagnostic
NEXT_PUBLIC_CALENDLY_URL=

# ── Enfoque Visual (enfoque.advibeagencia.com) ─────────────────────────────
# Detalle y verificación: docs/enfoque-visual-produccion.md
NEXT_PUBLIC_SITE_URL=https://enfoque.advibeagencia.com
NEXT_PUBLIC_WHATSAPP_NUMBER=593XXXXXXXXX
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Dataset/pixel propio de Enfoque (debe ser el mismo en navegador y servidor)
NEXT_PUBLIC_ENFOQUE_META_PIXEL_ID=
META_ENFOQUE_PIXEL_ID=
META_ENFOQUE_ACCESS_TOKEN=
META_ENFOQUE_GRAPH_API_VERSION=v26.0
NEXT_PUBLIC_ENFOQUE_GA_ID=
# Solo para verificar en "Probar eventos"; bórrala después
# META_ENFOQUE_TEST_EVENT_CODE=
# Datos demo: nunca en producción salvo opt-in explícito
# ENFOQUE_ALLOW_DEMO=false
