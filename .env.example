# Clave de la API de Google Gemini. Se usa SOLO en el servidor.
# Consíguela en Google AI Studio y pégala en un archivo .env.local (no se sube a Git).
GEMINI_API_KEY=your_api_key_here

# Opcional. Identificador del modelo de imagen (Nano Banana 2).
# Por defecto: gemini-3.1-flash-image (version GA, oficial desde el 28-05-2026)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Opcional. Ponlo a 1 para probar la aplicación con imágenes simuladas,
# sin llamar a Gemini y sin consumir créditos. Déjalo desactivado para generar de verdad.
# GEMINI_MOCK_MODE=1
