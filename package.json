{
  "name": "advibe-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./tests/register.mjs --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node tests/e2e/e2e.mjs",
    "test:batch": "node tests/e2e/batch.mjs",
    "test:fixtures": "node --import ./tests/register.mjs tests/e2e/make-fixtures.mjs && node --import ./tests/register.mjs tests/e2e/make-batch.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
